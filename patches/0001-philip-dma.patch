 #include CONFIG_DEVICES
 
+#define PHILIP_DMA_ACPI_HID   "PHL0001"
+#define PHILIP_DMA_ACPI_NAME  "PDMA"
+
+#define PHILIP_DMA_BASE       0xFE800000
+#define PHILIP_DMA_SIZE       0x1000
+#define PHILIP_DMA_GSI        16
+
 static void acpi_dsdt_add_virtio(Aml *scope,
                                  MicrovmMachineState *mms)
 {
@@ -99,6 +106,128 @@ static void acpi_dsdt_add_pci(Aml *scope, MicrovmMachineState *mms)
     acpi_dsdt_add_gpex(scope, &mms->gpex);
 }
 
+static void acpi_dsdt_add_philip_dma(Aml *scope)
+{
+    Aml *dev;
+    Aml *crs;
+    uint32_t irq;
+
+    /*
+     * ACPI Device object:
+     *
+     * Device (PDMA)
+     * {
+     *     _HID = "PHL0001"
+     *     _UID = 0
+     *     _STA = 0x0F
+     *     _CRS = ...
+     * }
+     */
+    dev = aml_device(PHILIP_DMA_ACPI_NAME);
+
+    aml_append(
+        dev,
+        aml_name_decl(
+            "_HID",
+            aml_string(PHILIP_DMA_ACPI_HID)
+        )
+    );
+
+    aml_append(
+        dev,
+        aml_name_decl(
+            "_UID",
+            aml_int(0)
+        )
+    );
+
+    /*
+     * Device is:
+     *
+     * bit0 = present
+     * bit1 = enabled
+     * bit2 = shown in UI
+     * bit3 = functioning
+     *
+     * 0x0F = all four set.
+     */
+    aml_append(
+        dev,
+        aml_name_decl(
+            "_STA",
+            aml_int(0x0F)
+        )
+    );
+
+
+    /*
+     * Build _CRS:
+     * Current Resource Settings
+     */
+    crs = aml_resource_template();
+
+
+    /*
+     * MMIO:
+     *
+     * 0xFE800000
+     * size 0x1000
+     */
+    aml_append(
+        crs,
+        aml_memory32_fixed(
+            PHILIP_DMA_BASE,
+            PHILIP_DMA_SIZE,
+            AML_READ_WRITE
+        )
+    );
+
+
+    /*
+     * Interrupt:
+     *
+     * GSI 16
+     * level-sensitive
+     * active-high
+     *
+     * This matches philip_dma_update_irq():
+     *
+     * IRQ_DONE set
+     *     -> qemu_set_irq(..., 1)
+     *
+     * W1C IRQ_STATUS
+     *     -> qemu_set_irq(..., 0)
+     */
+    irq = PHILIP_DMA_GSI;
+
+    aml_append(
+        crs,
+        aml_interrupt(
+            AML_CONSUMER,
+            AML_LEVEL,
+            AML_ACTIVE_HIGH,
+            AML_EXCLUSIVE,
+            &irq,
+            1
+        )
+    );
+
+
+    aml_append(
+        dev,
+        aml_name_decl(
+            "_CRS",
+            crs
+        )
+    );
+
+
+    aml_append(
+        scope,
+        dev
+    );
+}
+
 static void
 build_dsdt_microvm(GArray *table_data, BIOSLinker *linker,
                    MicrovmMachineState *mms)
@@ -125,6 +254,7 @@ build_dsdt_microvm(GArray *table_data, BIOSLinker *linker,
     acpi_dsdt_add_power_button(sb_scope);
     acpi_dsdt_add_virtio(sb_scope, mms);
     acpi_dsdt_add_xhci(sb_scope, mms);
+    acpi_dsdt_add_philip_dma(sb_scope);
     acpi_dsdt_add_pci(sb_scope, mms);
     aml_append(dsdt, sb_scope);
 
